# Template, not installed. One nightly sleep tick: consolidate, reflect, dream (see cto/sleep.py).
[Unit]
Description=Reverie nightly sleep tick (consolidation, reflection and dreams)
After=reverie.service
# Never pulls the console up; a tick while it is down simply does not run.
Requisite=reverie.service

[Service]
Type=oneshot
# Required: sets FLEET_SLEEP_POLICY (the external sleep policy inside the container).
EnvironmentFile=%h/.config/reverie/sleep.env
# The same interpreter and source the agent plugin's memory bridge uses.
ExecStart=%h/.local/libexec/reverie/fleet-container engine exec --user cto reverie-live env PYTHONPATH=/workspace /opt/fleet/python/bin/python3 -m cto.sleep tick --policy ${FLEET_SLEEP_POLICY}
# A pass stops starting new work after 8 minutes; a running model call finishes first.
TimeoutStartSec=20min
UMask=0077
