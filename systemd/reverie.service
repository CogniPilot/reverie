[Unit]
Description=Reverie fleet console
Wants=network-online.target
After=network-online.target reverie-engine.service
Requires=reverie-engine.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=exec
Environment=REVERIE_REPO=%h/git/reverie
ExecStart=%h/.local/libexec/reverie/fleet-container engine start --attach --sig-proxy=false reverie-live
ExecStop=%h/.local/libexec/reverie/fleet-container engine stop --time=30 reverie-live
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=process
UMask=0077

[Install]
WantedBy=default.target
