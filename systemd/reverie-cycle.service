# Template, not installed. One night-cycle tick: at most one model phase, only when the host GPU is idle.
# Owner reviews and activates: see docs/night-cycle.md.
[Unit]
Description=Reverie night cycle tick (consolidation and dreams)
After=reverie.service
# Never pulls the console up; a tick while it is down simply does not run.
Requisite=reverie.service

[Service]
Type=oneshot
Environment=REVERIE_REPO=%h/git/reverie
# Required: sets REVERIE_CYCLE_POLICY (the external night-cycle policy inside the container).
EnvironmentFile=%h/reverie/runtime/config/cycle.env
# Host-only check (the container cannot see host GPU users). Non-zero skips this tick, fails closed.
ExecCondition=%h/reverie/runtime/bin/gpu-idle-check
ExecStart=/bin/sh -c 'exec %h/reverie/runtime/bin/reverie-container engine exec --user agent reverie-live /opt/reverie/python/bin/reverie-cycle --policy "$${REVERIE_CYCLE_POLICY}" tick --max-model-phases 1'
# One model phase is bounded by its policy caps; stopping this unit ends only the podman client.
# The owner's stop is `reverie-cycle --policy ... pause`.
TimeoutStartSec=20min
UMask=0077
