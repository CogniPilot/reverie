# Template, not installed. Owner reviews and activates: see docs/runtime-watcher.md "Supervision".
[Unit]
Description=Reverie CTO runtime watcher
# Stops with the console and is started again with it (WantedBy below), so a container
# restart brings the watcher back without anyone typing a command.
BindsTo=reverie.service
After=reverie.service
StartLimitIntervalSec=0

[Service]
Environment=REVERIE_REPO=%h/git/reverie
# Required: REVERIE_RUNTIME_POLICY is the container-visible owner-selected policy; the older FLEET_ spelling is still read.
EnvironmentFile=%h/.config/reverie/runtime.env
Type=exec
# The console needs a few seconds after the container starts; ticks before that only log errors.
ExecStartPre=/usr/bin/env sleep 15
ExecStart=/bin/sh -c 'exec %h/.local/libexec/reverie/fleet-container engine exec --user cto reverie-live /opt/fleet/python/bin/fleet-runtime --policy "$${REVERIE_RUNTIME_POLICY:-$${FLEET_RUNTIME_POLICY}}" watch'
# Stopping the unit kills only the podman client; the in-container watcher (and any standby)
# would keep running and keep holding the lock. End them explicitly.
ExecStopPost=-/bin/sh -c 'exec %h/.local/libexec/reverie/fleet-container engine exec --user cto reverie-live /opt/fleet/python/bin/fleet-runtime --policy "$${REVERIE_RUNTIME_POLICY:-$${FLEET_RUNTIME_POLICY}}" stop-watcher'
# A crash restarts it. `systemctl --user stop reverie-watcher` is an intentional stop.
Restart=on-failure
RestartSec=30
UMask=0077

[Install]
WantedBy=reverie.service
