# Template, not installed. Restarts a watcher that is running but no longer ticking.
[Unit]
Description=Check that the Reverie runtime watcher is ticking
After=reverie-watcher.service

[Service]
Environment=FLEET_REPO=%h/git/reverie
# Required: FLEET_RUNTIME_POLICY is the container-visible owner-selected policy.
EnvironmentFile=%h/.config/reverie/runtime.env
Type=oneshot
# Restart only a watcher that is not ticking (a hang the per-tick alarm did not end). A ticking
# watcher whose ticks fail is reported by `status`, not restarted. try-restart never starts a
# watcher the owner stopped, and never pulls the console up through BindsTo.
ExecStart=/bin/sh -c '%h/.local/libexec/reverie/fleet-container engine exec --user cto reverie-live /opt/fleet/python/bin/fleet-runtime --policy "$${FLEET_RUNTIME_POLICY}" watcher-health || { echo "watcher heartbeat stale; restarting" >&2; systemctl --user try-restart reverie-watcher.service; }'
