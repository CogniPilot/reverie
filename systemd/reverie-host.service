[Unit]
Description=Reverie external host IT request bridge
After=network-online.target reverie.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/reverie/runtime/host/node %h/reverie/runtime/host/host-bridge.mjs --config %h/reverie/runtime/host/profile.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
