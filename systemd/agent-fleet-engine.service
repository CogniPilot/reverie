[Unit]
Description=Rootless Reverie container engine API

[Service]
Type=simple
Environment=FLEET_REPO=%h/git/reverie
ExecStart=%h/.local/libexec/agent-fleet/fleet-container engine system service --time=0 unix:%t/agent-fleet-engine.sock
Restart=on-failure
RestartSec=5
UMask=0077
KillMode=process

[Install]
WantedBy=default.target
