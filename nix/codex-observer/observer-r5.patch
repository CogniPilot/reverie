+//! Optional redacted diagnostics, never a trust/eligibility input.
+//!
+//! This cache records the discovery that populated this exact engine. It does not
+//! rediscover hooks, fingerprint executable bytes, or prove process spawn. Only
+//! synchronous PostToolUse execution in the scoped caller is observed.
+use super::{ClaudeHooksEngine, ConfiguredHandler, HandlerRunResult, HandlerSourcePath, HookListEntry};
+use codex_protocol::protocol::{HookEventName, HookTrustStatus};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::collections::HashMap;
+use std::future::Future;
+use std::sync::Arc;
+use uuid::Uuid;
+
+#[derive(Debug, Clone)]
+struct Descriptor {
+    configuration_sha256: String,
+    trust_status: HookTrustStatus,
+    engine_bypass_hook_trust: bool,
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct CachedSelection {
+    snapshot_id: String,
+    descriptors: HashMap<String, Descriptor>,
+}
+
+/// Called once with the same admitted handlers and entries returned by discovery.
+/// An ambiguous/nonlocal/invalid descriptor stays unavailable, never trusted.
+pub(crate) fn snapshot(
+    handlers: &[ConfiguredHandler],
+    entries: &[HookListEntry],
+    bypass_hook_trust: bool,
+) -> CachedSelection {
+    if !enabled() { return CachedSelection::default(); }
+    let mut cache = CachedSelection {
+        snapshot_id: Uuid::new_v4().to_string(),
+        descriptors: HashMap::new(),
+    };
+    for handler in handlers {
+        let HandlerSourcePath::Local(path) = &handler.source_path else { continue };
+        let mut matching = entries.iter().filter(|entry| {
+            entry.event_name == handler.event_name
+                && entry.display_order == handler.display_order
+                && entry.source == handler.source
+                && entry.source_path.as_path() == path.as_path()
+                && entry.builtin == handler.builtin
+                && entry.enabled
+        });
+        let Some(entry) = matching.next() else { continue };
+        if matching.next().is_some() || !valid_sha(&entry.current_hash) {
+            continue;
+        }
+        // Do not manufacture eligibility: only discovery-admitted handlers enter
+        // this snapshot; untrusted selected with explicit bypass remains untrusted.
+        cache.descriptors.insert(handler.run_id(), Descriptor {
+            configuration_sha256: entry.current_hash.clone(),
+            trust_status: entry.trust_status,
+            engine_bypass_hook_trust: bypass_hook_trust,
+        });
+    }
+    cache
+}
+
+fn valid_sha(value: &str) -> bool {
+    value.strip_prefix("sha256:").is_some_and(|hex| {
+        hex.len() == 64 && hex.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    })
+}
+
+fn digest(value: &str) -> String {
+    format!("sha256:{:x}", Sha256::digest(value.as_bytes()))
+}
+
+fn valid_identity(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 128 && value.bytes().all(|b| b.is_ascii_graphic())
+}
+
+fn enabled() -> bool {
+    std::env::var_os("CODEX_REDACTED_HOOK_OBSERVER").is_some_and(|value| value == "1")
+}
+
+#[derive(Clone)]
+struct Invocation {
+    thread_id: String,
+    turn_id: Option<String>,
+    tool_use_id: Option<String>,
+    event_name: HookEventName,
+}
+
+tokio::task_local! { static ACTIVE: Arc<Invocation>; }
+
+/// Scope the unchanged dispatcher future. Tokio-spawned async handlers do not
+/// inherit task locals and are outside this diagnostic coverage.
+pub(crate) async fn with_post_tool_dispatch<F: Future>(
+    thread_id: String,
+    turn_id: &str,
+    tool_use_id: &str,
+    future: F,
+) -> F::Output {
+    with_context_dispatch(thread_id, Some(turn_id), HookEventName::PostToolUse, Some(tool_use_id), future).await
+}
+
+/// Actual native event identities; SessionStart may have no turn, and events
+/// without a native tool-use suffix never receive an invented one.
+pub(crate) async fn with_context_dispatch<F: Future>(
+    thread_id: String,
+    turn_id: Option<&str>,
+    event_name: HookEventName,
+    tool_use_id: Option<&str>,
+    future: F,
+) -> F::Output {
+    let valid_event = match event_name {
+        HookEventName::SessionStart => tool_use_id.is_none(),
+        HookEventName::UserPromptSubmit => turn_id.is_some() && tool_use_id.is_none(),
+        HookEventName::PostToolUse => turn_id.is_some() && tool_use_id.is_some(),
+        _ => false,
+    };
+    if !enabled() || !valid_event || !valid_identity(&thread_id)
+        || turn_id.is_some_and(|id| !valid_identity(id))
+        || tool_use_id.is_some_and(|id| !valid_identity(id))
+    {
+        return future.await;
+    }
+    ACTIVE.scope(Arc::new(Invocation {
+        thread_id, turn_id: turn_id.map(str::to_owned),
+        tool_use_id: tool_use_id.map(str::to_owned), event_name,
+    }), future).await
+}
+
+pub(crate) struct DispatchObservation {
+    binding: Arc<Invocation>,
+    row: Value,
+    returned: bool,
+}
+
+/// Called inside execute_handler immediately before the original handler branch.
+/// This attests dispatch entry for this selected handler, not OS spawn success.
+pub(crate) fn dispatched(
+    engine: &ClaudeHooksEngine,
+    handler: &ConfiguredHandler,
+) -> Option<DispatchObservation> {
+    if !enabled() || !matches!(&handler.source_path, HandlerSourcePath::Local(_)) {
+        return None;
+    }
+    let binding = ACTIVE.try_with(Arc::clone).ok()?;
+    if handler.event_name != binding.event_name { return None; }
+    let run_id = handler.run_id();
+    if run_id.len() > 8192 { return None; }
+    let descriptor = engine.observer_selection.descriptors.get(&run_id);
+    let mut observation = DispatchObservation {
+        binding,
+        returned: false,
+        row: json!({
+            "version": 1,
+            "dispatchId": Uuid::new_v4().to_string(),
+            "snapshotId": engine.observer_selection.snapshot_id,
+            "configurationFingerprintKind": "native_discovery_normalized_handler_config",
+            "configurationSha256": descriptor.map(|d| d.configuration_sha256.as_str()),
+            "nativeTrustStatus": descriptor.map(|d| match d.trust_status {
+                HookTrustStatus::Managed => "managed",
+                HookTrustStatus::Trusted => "trusted",
+                HookTrustStatus::Untrusted => "untrusted",
+                HookTrustStatus::Modified => "modified",
+            }),
+            "engineBypassHookTrust": descriptor.map(|d| d.engine_bypass_hook_trust),
+            "selectionRequiredBypass": descriptor.map(|d| matches!(
+                d.trust_status, HookTrustStatus::Untrusted | HookTrustStatus::Modified,
+            )),
+            "cachedSelection": if descriptor.is_some() { "available" } else { "unavailable" },
+            "handlerBaseRunIdSha256": digest(&run_id),
+            "executedScriptSha256": Value::Null,
+            "qualification": if descriptor.is_some() {
+                "cached_selection_dispatch_entry_not_spawn_or_script_byte_attestation"
+            } else {
+                "dispatch_entry_cached_selection_unavailable"
+            },
+            "coverage": "sync_session_start_user_prompt_submit_post_tool_use_best_effort_queues_may_drop",
+        }),
+    };
+    let native_run_id = match &observation.binding.tool_use_id {
+        Some(tool_use_id) => format!("{run_id}:{tool_use_id}"),
+        None => run_id,
+    };
+    observation.row["eventName"] = json!(match observation.binding.event_name {
+        HookEventName::SessionStart => "SessionStart",
+        HookEventName::UserPromptSubmit => "UserPromptSubmit",
+        HookEventName::PostToolUse => "PostToolUse",
+        _ => "unsupported",
+    });
+    observation.row["toolUseCorrelation"] = json!(if observation.binding.tool_use_id.is_some() {
+        "native_post_tool_use_suffix"
+    } else { "not_applicable" });
+    observation.row["runIdSha256"] = json!(digest(&native_run_id));
+    observation.emit("dispatch_entered", json!({}));
+    Some(observation)
+}
+
+impl DispatchObservation {
+    pub(crate) fn returned(&mut self, result: &HandlerRunResult) {
+        self.returned = true;
+        self.emit("handler_future_returned", json!({
+            "exitCode": result.exit_code,
+            "hasError": result.error.is_some(),
+            "commandOutcomeClass": "native_result_unclassified",
+        }));
+    }
+
+    fn emit(&self, stage: &str, details: Value) {
+        let mut row = self.row.clone();
+        row["stage"] = json!(stage);
+        row["threadId"] = json!(&self.binding.thread_id);
+        row["turnId"] = json!(&self.binding.turn_id);
+        row["details"] = details;
+        row["namespacePid"] = json!(std::process::id());
+        row["namespaceStartTick"] = json!(namespace_start_tick());
+        let thread_id = &self.binding.thread_id;
+        tracing::info!(target: "codex_hook_dispatch_observer", parent: None,
+            thread_id = %thread_id, hook_dispatch_observation = %row,
+            "redacted cached hook dispatch observation");
+    }
+}
+
+impl Drop for DispatchObservation {
+    fn drop(&mut self) {
+        if !self.returned {
+            self.emit("handler_future_dropped", json!({"outcome": "unknown"}));
+        }
+    }
+}
+
+fn namespace_start_tick() -> Option<u64> {
+    let stat = std::fs::read_to_string("/proc/self/stat").ok()?;
+    stat.rsplit_once(')')?.1.split_whitespace().nth(19)?.parse().ok()
+}
