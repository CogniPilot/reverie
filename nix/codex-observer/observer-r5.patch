+//! Actual ContextManager/HookAdditionalContext tests, using owned literal data.
+use super::*;
+use crate::context::{ContextualUserFragment, HookAdditionalContext};
+use crate::context_manager::ContextManager;
+use codex_protocol::protocol::{HookExecutionMode, HookHandlerType, HookRunStatus, HookRunSummary, HookScope, HookSource};
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_output_truncation::TruncationPolicy;
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::task::{Context, Poll, Wake, Waker};
+use tracing::{Event, Metadata, Subscriber};
+use tracing::span::{Attributes, Id, Record};
+
+const THREAD: &str = "11111111-1111-4111-8111-111111111111";
+fn run(event: HookEventName, turn: Option<&str>) -> HookCompletedEvent {
+    HookCompletedEvent { turn_id: turn.map(str::to_owned), run: HookRunSummary {
+        builtin: false, id: format!("{}:0:owned-fixture", event_label(event).expect("supported event")),
+        event_name: event, handler_type: HookHandlerType::Command, execution_mode: HookExecutionMode::Sync,
+        scope: if event == HookEventName::SessionStart { HookScope::Thread } else { HookScope::Turn },
+        source_path: AbsolutePathBuf::try_from(PathBuf::from("/OWNED-CONTEXT-FIXTURE/hooks.json")).expect("literal metadata path"),
+        source: HookSource::User, display_order: 0, status: HookRunStatus::Completed,
+        status_message: None, started_at: 1, completed_at: Some(2), duration_ms: Some(1), entries: Vec::new(),
+    }}
