+//! Optional diagnostic scope for actual managed context-hook history admission.
+//! No model input, history item, protocol, trust or execution result is changed.
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::HookCompletedEvent;
+use codex_protocol::protocol::HookEventName;
+use serde_json::Value;
+use serde_json::json;
+use sha2::Digest;
+use sha2::Sha256;
+use std::future::Future;
+use std::sync::Arc;
+use std::sync::LazyLock;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+static ENABLED: LazyLock<bool> = LazyLock::new(||
+    std::env::var_os("CODEX_REDACTED_HOOK_OBSERVER").as_deref() == Some(std::ffi::OsStr::new("1")));
+static START_TICK: LazyLock<Option<u64>> = LazyLock::new(|| {
+    let stat = std::fs::read_to_string("/proc/self/stat").ok()?;
+    stat.rsplit_once(')')?.1.split_whitespace().nth(19)?.parse().ok()
+});
+struct Binding {
+    batch_id: String,
+    thread_id: String,
+    turn_id: String,
+    dispatch_turn_id: Option<String>,
+    event_name: HookEventName,
+    phase: &'static str,
+    run_ids: Vec<String>,
+    input: Value,
+    admitted: AtomicUsize,
+}
+tokio::task_local! { static ACTIVE: Arc<Binding>; }
+
+/// Opaque metadata-only token, moved with the original hook outcome until its
+/// own additional-context record future runs. It never holds context text.
+pub(crate) struct ContextObservation(Arc<Binding>);
+
+fn event_label(event: HookEventName) -> Option<&'static str> {
+    match event {
+        HookEventName::SessionStart => Some("SessionStart"),
+        HookEventName::UserPromptSubmit => Some("UserPromptSubmit"),
+        HookEventName::PostToolUse => Some("PostToolUse"),
+        _ => None,
+    }
+}
+
+
+fn digest(bytes: &[u8]) -> String { format!("sha256:{:x}", Sha256::digest(bytes)) }
+
+fn texts_summary(texts: &[&str]) -> Option<Value> {
+    if texts.len() > 128 { return None; }
+    let bytes = texts.iter().try_fold(0_usize, |n,t| n.checked_add(t.len()))?;
+    if bytes > 1024 * 1024 { return None; }
+    let mut hash=Sha256::new();hash.update(b"codex-hook-context-list-v1\0");
+    let mut entries=Vec::new();
+    for (i,text) in texts.iter().enumerate() {
+        hash.update((i as u64).to_be_bytes());hash.update((text.len() as u64).to_be_bytes());hash.update(text.as_bytes());
+        entries.push(json!({"bytes":text.len(),"sha256":digest(text.as_bytes())}));
+    }
+    hash.update((texts.len() as u64).to_be_bytes());
+    Some(json!({"count":texts.len(),"bytes":bytes,"entries":entries,"framedListSha256":format!("sha256:{:x}",hash.finalize())}))
+}
+
+fn emit(binding: &Binding, stage: &'static str, details: Value) {
+    let row=json!({"schemaVersion":1,"stage":stage,"threadId":binding.thread_id,
+        "turnId":binding.turn_id,"admissionTurnId":binding.turn_id,
+        "dispatchTurnId":binding.dispatch_turn_id,"eventName":event_label(binding.event_name),
+        "phase":binding.phase,"batchId":binding.batch_id,"runIdSha256s":binding.run_ids,
+        "runAssociation":"native_context_hook_outcome_run_set_not_per_entry_assignment",
+        "namespacePid":std::process::id(),"namespaceStartTick":*START_TICK,
+        "details":details,"qualification":"context_history_recorded_not_provider_or_model_consumption",
+        "coverage":"best_effort_log_queue_no_absence_inference"});
+    tracing::info!(target:"codex_hook_context_observer",parent:None,
+        thread_id=binding.thread_id.as_str(),hook_context_observation=%row,"redacted hook context admission");
+}
+
+/// Captures only the actual returned native outcome metadata. A later native
+/// record call must consume this token; merely preparing it claims no admission.
+pub(crate) fn prepare_context_observation(
+    thread_id: String,
+    admission_turn_id: &str,
+    dispatch_turn_id: Option<&str>,
+    event_name: HookEventName,
+    phase: &'static str,
+    runs: &[HookCompletedEvent],
+    contexts: &[String],
+) -> Option<ContextObservation> {
+    if !*ENABLED { return None; }
+    let valid_id=|id:&str| !id.is_empty() && id.len()<=128 && id.bytes().all(|b|b.is_ascii_graphic());
+    if !valid_id(&thread_id) || !valid_id(admission_turn_id)
+        || dispatch_turn_id.is_some_and(|id| !valid_id(id)) || event_label(event_name).is_none()
+        || runs.len()>128 || contexts.len()>128 || runs.iter().any(|r|
+            r.run.id.len()>8192 || r.turn_id.as_deref()!=dispatch_turn_id || r.run.event_name!=event_name)
+    {
+        tracing::info!(target:"codex_hook_context_observer",parent:None,reason_code="binding_bounds","redacted hook context scope refused");
+        return None;
+    }
+    let input=texts_summary(&contexts.iter().map(String::as_str).collect::<Vec<_>>());
+    let Some(input)=input else {
+        tracing::info!(target:"codex_hook_context_observer",parent:None,reason_code="binding_bounds","redacted hook context scope refused");
+        return None;
+    };
+    Some(ContextObservation(Arc::new(Binding {
+        batch_id:uuid::Uuid::new_v4().to_string(),thread_id,turn_id:admission_turn_id.to_owned(),
+        dispatch_turn_id:dispatch_turn_id.map(str::to_owned),event_name,phase,
+        run_ids:runs.iter().map(|r|digest(r.run.id.as_bytes())).collect(),input,admitted:AtomicUsize::new(0),
+    })))
+}
+
+struct AdmissionGuard { binding: Arc<Binding>, returned: bool }
+impl Drop for AdmissionGuard {
+    fn drop(&mut self) {
+        if !self.returned {
+            emit(&self.binding,"context_batch_future_dropped",json!({
+                "outcome":"unknown","admittedItems":self.binding.admitted.load(Ordering::Relaxed),
+            }));
+        }
+    }
+}
+
+/// Activates correlation ONLY around this outcome's own context-record future,
+/// after any user-input recording. The original future/output are unchanged.
+pub(crate) async fn record_observed<F: Future>(
+    observation: Option<ContextObservation>, record: F,
+) -> F::Output {
+    let Some(ContextObservation(binding))=observation else { return record.await; };
+    let mut guard=AdmissionGuard{binding:binding.clone(),returned:false};
+    emit(&binding,"context_batch_started",json!({"input":binding.input}));
+    let output=ACTIVE.scope(binding.clone(),record).await;
+    guard.returned=true;
+    emit(&binding,"context_batch_returned",json!({
+        "recordFutureReturned":true,"admittedItems":binding.admitted.load(Ordering::Relaxed),
+    }));
+    output
+}
+
+/// Existing PostToolUse result/cancellation semantics remain unchanged.
+pub(crate) async fn with_post_tool_contexts<F,T,E>(
+    thread_id: String, turn_id: &str, runs: &[HookCompletedEvent], contexts: &[String], record: F,
+) -> Result<T,E>
+where F:Future<Output=Result<T,E>> {
+    let observation=prepare_context_observation(thread_id,turn_id,Some(turn_id),HookEventName::PostToolUse,
+        "post_tool_result",runs,contexts);
+    let Some(ContextObservation(binding))=observation else { return record.await; };
+    let mut guard=AdmissionGuard{binding:binding.clone(),returned:false};
+    emit(&binding,"post_tool_context_batch_started",json!({"input":binding.input}));
+    let result=ACTIVE.scope(binding.clone(),record).await;
+    guard.returned=true;
+    emit(&binding,"post_tool_context_batch_returned",json!({
+        "recordFutureSucceeded":result.is_ok(),"admittedItems":binding.admitted.load(Ordering::Relaxed),
+    }));
+    result
+}
+
+/// Called only AFTER the processed item was pushed into ContextManager.items.
+/// No full history scan, context-body mutation or transcript read occurs.
+pub(crate) fn recorded_item(item: &ResponseItem) {
+    if !*ENABLED { return; }
+    let _=ACTIVE.try_with(|binding| {
+        let ordinal=binding.admitted.fetch_add(1,Ordering::Relaxed);
+        let ResponseItem::Message{role,content,..}=item else {
+            emit(binding,"context_manager_item_recorded_projection_refused",json!({"ordinal":ordinal,"reasonCode":"non_message"}));return;
+        };
+        if role!="developer" {
+            emit(binding,"context_manager_item_recorded_projection_refused",json!({"ordinal":ordinal,"reasonCode":"non_developer"}));return;
+        }
+        if content.len()>128 {
+            emit(binding,"context_manager_item_recorded_projection_refused",json!({"ordinal":ordinal,"reasonCode":"part_count_bounds"}));return;
+        }
+        let mut texts=Vec::new();
+        for part in content {
+            let ContentItem::InputText{text,..}=part else {
+                emit(binding,"context_manager_item_recorded_projection_refused",json!({"ordinal":ordinal,"reasonCode":"non_text"}));return;
+            };
+            texts.push(text.as_str());
+        }
+        match texts_summary(&texts) {
+            Some(summary)=>emit(binding,"context_manager_developer_item_recorded",json!({"ordinal":ordinal,"content":summary})),
+            None=>emit(binding,"context_manager_item_recorded_projection_refused",json!({"ordinal":ordinal,"reasonCode":"content_bounds"})),
+        }
+    });
+}
