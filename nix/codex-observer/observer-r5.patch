+//! Source-only proposal: redacted observations at the native TUI consumer.
+//! Nothing here records hook text, paths, status messages, commands or errors.
+//! This is diagnostic metadata, not proof that a model consumed the context.
+
+use codex_app_server_protocol::HookOutputEntryKind;
+use codex_app_server_protocol::HookRunStatus;
+use codex_app_server_protocol::HookRunSummary;
+use serde_json::Value;
+use serde_json::json;
+use sha2::Digest;
+use sha2::Sha256;
+use std::sync::LazyLock;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+const MAX_ENTRIES: usize = 128;
+const MAX_ENTRY_BYTES: usize = 1024 * 1024;
+static SEQUENCE: AtomicU64 = AtomicU64::new(0);
+// Proposed opt-in for an explicitly reviewed future native diagnostic build;
+// this key does not exist in the currently installed binary.
+static ENABLED: LazyLock<bool> = LazyLock::new(|| {
+    std::env::var_os("CODEX_REDACTED_HOOK_OBSERVER").as_deref() == Some(std::ffi::OsStr::new("1"))
+});
+static OBSERVER_ID: LazyLock<String> = LazyLock::new(|| uuid::Uuid::new_v4().to_string());
+static START_TICK: LazyLock<Option<u64>> = LazyLock::new(|| {
+    // This reads only the observer's own process identity, never an agent's
+    // transcript, environment, configuration, error or memory content.
+    let stat = std::fs::read_to_string("/proc/self/stat").ok()?;
+    stat.rsplit_once(')')?.1.split_whitespace().nth(19)?.parse().ok()
+});
+
+fn digest(bytes: &[u8]) -> String {
+    format!("sha256:{:x}", Sha256::digest(bytes))
+}
+
+/// Pure projection over the real app-server HookRunSummary fields. A host-side
+/// current-process join is deliberately not invented by this native consumer.
+pub(crate) fn project_received(
+    thread_id: &str,
+    turn_id: Option<&str>,
+    run: &HookRunSummary,
+    replay: bool,
+) -> Result<Value, &'static str> {
+    let bounded_id = |id: &str| !id.is_empty() && id.len() <= 128 && id.bytes().all(|b| b.is_ascii_graphic());
+    if !bounded_id(thread_id) || turn_id.is_some_and(|id| !bounded_id(id)) {
+        return Err("identity_bounds");
+    }
+    let path = run.source_path.as_path().as_os_str().as_encoded_bytes();
+    if run.id.len() > 8192 || path.len() > 8192 || run.entries.len() > MAX_ENTRIES {
+        return Err("run_bounds");
+    }
+    let total = run.entries.iter().try_fold(0_usize, |n, e| n.checked_add(e.text.len()));
+    if total.is_none_or(|n| n > MAX_ENTRY_BYTES) {
+        return Err("entry_byte_bounds");
+    }
+    let mut counts = [0_u64; 5];
+    let mut context_bytes = 0_usize;
+    let mut contexts = Vec::new();
+    let mut hash = Sha256::new();
+    hash.update(b"codex-hook-context-list-v1\0");
+    for entry in &run.entries {
+        let index = match &entry.kind {
+            HookOutputEntryKind::Warning => 0,
+            HookOutputEntryKind::Stop => 1,
+            HookOutputEntryKind::Feedback => 2,
+            HookOutputEntryKind::Context => 3,
+            HookOutputEntryKind::Error => 4,
+        };
+        counts[index] += 1;
+        if index == 3 {
+            let bytes = entry.text.as_bytes();
+            hash.update((contexts.len() as u64).to_be_bytes());
+            hash.update((bytes.len() as u64).to_be_bytes());
+            hash.update(bytes);
+            context_bytes += bytes.len();
+            contexts.push(json!({"bytes": bytes.len(), "sha256": digest(bytes)}));
+        }
+    }
+    hash.update((contexts.len() as u64).to_be_bytes());
+    let failure = match &run.status {
+        HookRunStatus::Failed => Some("native_run_failed_unclassified"),
+        HookRunStatus::Blocked => Some("native_run_blocked"),
+        HookRunStatus::Stopped => Some("native_run_stopped"),
+        HookRunStatus::Running | HookRunStatus::Completed => None,
+    };
+    Ok(json!({
+        "schemaVersion": 1,
+        "stage": "native_tui_hook_notification_received",
+        "threadId": thread_id,
+        "turnId": turn_id,
+        "replay": replay,
+        "runIdSha256": digest(run.id.as_bytes()),
+        "sourcePathSha256": digest(path),
+        "eventName": &run.event_name,
+        "handlerType": &run.handler_type,
+        "executionMode": &run.execution_mode,
+        "scope": &run.scope,
+        "source": &run.source,
+        "displayOrder": run.display_order,
+        "status": &run.status,
+        "startedAt": run.started_at,
+        "completedAt": run.completed_at,
+        "durationMs": run.duration_ms,
+        "entryKinds": {"warning": counts[0], "stop": counts[1], "feedback": counts[2], "context": counts[3], "error": counts[4]},
+        "contextBytes": context_bytes,
+        "contexts": contexts,
+        "contextListSha256": format!("sha256:{:x}", hash.finalize()),
+        "contextHashScheme": "ordered_length_framed_utf8_v1",
+        "failureClass": failure,
+        "commandOutcome": null,
+        "nativeTrustFingerprint": null,
+        "qualification": "consumer_received_only_not_model_consumption",
+        "coverage": "best_effort_upstream_and_log_queues_may_drop"
+    }))
+}
+
+/// Called at the actual TUI hook notification boundary before its normal
+/// consumer runs. Parentless tracing avoids inheriting arbitrary span fields.
+pub(crate) fn observe_received(
+    method: &'static str,
+    thread_id: &str,
+    turn_id: Option<&str>,
+    run: &HookRunSummary,
+    replay: bool,
+) {
+    if !*ENABLED {
+        return;
+    }
+    let sequence = SEQUENCE.fetch_add(1, Ordering::Relaxed);
+    let mut row = match project_received(thread_id, turn_id, run, replay) {
+        Ok(row) => row,
+        Err(code) => json!({"schemaVersion":1,"stage":"native_tui_hook_notification_refused","reasonCode":code}),
+    };
+    row["method"] = json!(method);
+    row["observerId"] = json!(OBSERVER_ID.as_str());
+    row["sequence"] = json!(sequence);
+    row["namespacePid"] = json!(std::process::id());
+    row["namespaceStartTick"] = json!(*START_TICK);
+    // The existing SQLite layer indexes this exact field. On redaction refusal
+    // never fall back to the unvalidated original identity.
+    let indexed_thread = row.get("threadId").and_then(Value::as_str).unwrap_or("");
+    // No Debug/Display of the native notification or run is permitted here.
+    tracing::info!(target: "codex_hook_observer", parent: None,
+        thread_id = indexed_thread, hook_observation = %row, "redacted hook consumer observation");
+}
