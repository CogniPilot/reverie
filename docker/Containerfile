FROM docker.io/library/node:22-bookworm-slim AS console-dependencies
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/fleet/apps/console
COPY apps/console/package.json apps/console/package-lock.json ./
# The upstream package has workspaces; their manifests are part of the lockfile.
COPY apps/console/packages ./packages
ENV CI=1 CODEMAN_NO_AUTOSTART=1 PUPPETEER_SKIP_DOWNLOAD=1 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --ignore-scripts && npm rebuild node-pty esbuild
COPY apps/console ./
FROM console-dependencies AS console-test
RUN apt-get update && apt-get install -y --no-install-recommends git tmux ripgrep \
    && rm -rf /var/lib/apt/lists/*
RUN node scripts/prepare-spreadsheet-assets.mjs \
    && chown -R node:node /opt/fleet/apps/console
USER node
CMD ["npm", "test"]

FROM console-test AS console-browser-test
USER root
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
USER node
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
CMD ["npm", "run", "test:browser"]

FROM console-dependencies AS console-build
RUN npm run build && npm prune --omit=dev --ignore-scripts

FROM docker.io/library/node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo python3 python3-venv build-essential git tmux ripgrep curl ca-certificates procps \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 2000 fleet \
    && useradd --uid 2000 --gid fleet --create-home --shell /bin/bash cto \
    && printf 'cto ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/fleet-cto \
    && chmod 0440 /etc/sudoers.d/fleet-cto && visudo --check \
    && install -d -m 2770 -o cto -g fleet /workspace /scratch /instances
# Agent CLIs live in the image, never only in a container's writable layer (lost on recreate). Claude Code is
# not shipped; the start script installs it on the volume when REVERIE_INSTALL_CLIS asks for it.
RUN npm install --global opencode-ai@1.18.31 @openai/codex@0.162.1 && npm cache clean --force \
    && rm -rf /tmp/node-compile-cache
WORKDIR /opt/fleet
COPY pyproject.toml README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY cto ./cto
COPY experts ./experts
COPY --from=console-build /opt/fleet/apps/console ./apps/console
COPY docker/image-requirements.txt ./docker/image-requirements.txt
# Extra packages are hash-pinned wheels only (no source builds, no unpinned downloads); the smoke step
# fails the build if Pillow cannot draw and save a PNG and a WebP.
RUN python3 -m venv /opt/fleet/python \
    && /opt/fleet/python/bin/pip install --no-cache-dir --no-deps /opt/fleet \
    && /opt/fleet/python/bin/pip install --no-cache-dir --only-binary=:all: --require-hashes -r ./docker/image-requirements.txt \
    && /opt/fleet/python/bin/python3 -I -c "from PIL import Image, ImageDraw; im = Image.new('RGBA', (64, 64)); ImageDraw.Draw(im).ellipse((8, 8, 56, 56), fill=(90, 60, 30, 255)); im.save('/tmp/pil-smoke.png'); im.save('/tmp/pil-smoke.webp'); assert Image.open('/tmp/pil-smoke.png').size == (64, 64)" \
    && rm -f /tmp/pil-smoke.png /tmp/pil-smoke.webp \
    && ln -s /opt/fleet/apps/console/dist/index.js /usr/local/bin/reverie \
    && ln -s /opt/fleet/apps/console/dist/index.js /usr/local/bin/fleet \
    && ln -s /opt/fleet/apps/console/dist/index.js /usr/local/bin/codeman
COPY --chmod=0755 docker/entrypoint.sh /usr/local/bin/reverie-start
ARG REVERIE_VERSION=dev
ENV REVERIE_VERSION=$REVERIE_VERSION HOME=/home/cto FLEET_CONTAINER=1 FLEET_CASES_PATH=/scratch/cases FLEET_RESEARCH_ROOT=/scratch/research TMPDIR=/scratch/tmp PATH=/opt/fleet/python/bin:$PATH
USER cto
WORKDIR /workspace
# The start script prepares the instance on a volume mounted at /instances (owner password, upgrade backup,
# opt-in CLIs), then runs the console. Any other command runs after the same preparation. The development
# and personal launchers bypass it with --entrypoint /usr/bin/env and pass their own command.
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/reverie-start"]
CMD ["reverie", "web", "--host", "0.0.0.0", "--port", "3000"]
