#!/bin/sh
# Container command: run the console under the in-container supervisor (python/reverie/supervise.py), so the console can
# restart or redeploy without stopping the container or its agents. Falls back to running the console directly if
# the supervisor or its interpreter is missing, so a broken checkout can never stop the container from starting.
here=$(dirname "$0")
supervisor="$here/../python/reverie/supervise.py"
python=/opt/reverie/python/bin/python3
data_dir="${REVERIE_DATA_DIR:-}"
state="${data_dir:-/tmp}/supervise"
# Optional owner-configured agent watchdog, outside every agent tmux pane.
# The policy and installed standard-library monitor live in private instance data.
watchdog_state="${data_dir:-/tmp}/watchdog"
if [ -x "$python" ] && [ -f "$watchdog_state/policy.json" ] && [ -f "$watchdog_state/bin/watchdog.py" ]; then
  setsid "$python" -I "$watchdog_state/bin/watchdog.py" --policy "$watchdog_state/policy.json" watch \
    </dev/null >>"$watchdog_state/watchdog.log" 2>&1 &
fi
if [ -x "$python" ] && [ -f "$supervisor" ]; then
  # The console's env file (state/child.env) may only name files under the instance's runtime dir: the parent of
  # the data dir, which comes from the container's own environment. Without a data dir it is not read.
  if [ -n "$data_dir" ]; then
    exec "$python" -I "$supervisor" run --state "$state" --rollback-dist /opt/reverie/apps/console/dist \
      --env-root "$(dirname "$data_dir")" -- "$@"
  fi
  exec "$python" -I "$supervisor" run --state "$state" --rollback-dist /opt/reverie/apps/console/dist -- "$@"
fi
echo "reverie-supervise: supervisor unavailable; starting the console unsupervised" >&2
exec "$@"
