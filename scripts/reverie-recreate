#!/usr/bin/env bash
# reverie-recreate: rebuild the Reverie image and recreate the live console container with
# the same bind mounts, user, capabilities, init, network, environment and command it had.
#
#   reverie-recreate --dry-run            print every check and command, change nothing
#   reverie-recreate                      build, then create (not start) the container; refuses if it exists
#   reverie-recreate --replace            stop and remove an existing container first
#
# Run on the HOST as the user that owns the container. Engine access goes through the
# launcher (scripts/reverie-container next to this file, or REVERIE_LAUNCHER), so engine storage
# follows its default (${XDG_DATA_HOME:-~/.local/share}/reverie/engine) or REVERIE_SCRATCH.
# Mounted data (repo, scratch, instance) is never deleted or rewritten: --replace removes
# only the container itself, never volumes or images.
#
# Options (defaults in brackets):
#   --name NAME              container name [reverie-live]
#   --image IMAGE            image tag to build and run [localhost/reverie:live]
#   --repo DIR               host repo mounted at /workspace [~/git/reverie]
#   --scratch DIR            host scratch mounted at /scratch [~/scratch/reverie/runtime]
#   --instance DIR           private instance directory [~/.local/share/reverie/default]
#   --instance-name NAME     it is mounted at /instances/NAME [default]
#   --console-source DIR     console tree baked into the image, e.g. a rescued copy [repo: apps/console]
#   --reverie-source DIR         reverie package baked into the image, e.g. a rescued copy [repo: python/reverie/]
#   --port PORT              host port for the console [3001]
#   --bind ADDR              host address it listens on [127.0.0.1]
#   --publish SPEC           raw publish spec, repeatable; replaces --bind/--port
#   --no-publish             publish no ports
#   --model ID / --api-base URL   local model settings, e.g. --api-base http://169.254.1.2:8080/v1
#                            [unset: the instance config and runtime defaults apply]
#   --no-build               reuse an existing IMAGE
#   --install-launcher       also install this reverie-container as
#                            ~/.local/libexec/reverie/reverie-container (backup kept), so
#                            reverie.service finds the container in the new engine storage
#   --dry-run                print, do not change anything
# REVERIE_MEMORY overrides the automatic memory size (half of host RAM, 4..32 GiB).
set -euo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source_repo="$(cd -- "$here/.." && pwd)"
launcher="${REVERIE_LAUNCHER:-$here/reverie-container}"
name=reverie-live
image="${REVERIE_IMAGE:-localhost/reverie:live}"
repo="$HOME/git/reverie"
scratch="$HOME/scratch/reverie/runtime"
instance="$HOME/.local/share/reverie/default"
instance_name=default
console_source=""
reverie_source=""
publish=()
host_port=3001
bind_addr=127.0.0.1
no_publish=0
model=""
api_base=""
dry=0
replace=0
build=1
install_launcher=0
installed_launcher="$HOME/.local/libexec/reverie/reverie-container"

die() { echo "reverie-recreate: $*" >&2; exit 1; }
need() { [ "$#" -ge 2 ] && [ -n "$2" ] || die "$1 needs a value"; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --name) need "$@"; name="$2"; shift 2 ;;
    --image) need "$@"; image="$2"; shift 2 ;;
    --repo) need "$@"; repo="$2"; shift 2 ;;
    --scratch) need "$@"; scratch="$2"; shift 2 ;;
    --instance) need "$@"; instance="$2"; shift 2 ;;
    --instance-name) need "$@"; instance_name="$2"; shift 2 ;;
    --console-source) need "$@"; console_source="$2"; shift 2 ;;
    --reverie-source) need "$@"; reverie_source="$2"; shift 2 ;;
    --publish) need "$@"; publish+=("$2"); shift 2 ;;
    --port) need "$@"; host_port="$2"; shift 2 ;;
    --bind) need "$@"; bind_addr="$2"; shift 2 ;;
    --no-publish) no_publish=1; shift ;;
    --model) need "$@"; model="$2"; shift 2 ;;
    --api-base) need "$@"; api_base="$2"; shift 2 ;;
    --no-build) build=0; shift ;;
    --replace) replace=1; shift ;;
    --install-launcher) install_launcher=1; shift ;;
    --dry-run) dry=1; shift ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option '$1' (see --help)" ;;
  esac
done
[[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "invalid container name '$name'"
[[ "$instance_name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "invalid --instance-name '$instance_name'"
target="/instances/$instance_name"
[[ "$host_port" =~ ^[0-9]+$ ]] && [ "$host_port" -ge 1 ] && [ "$host_port" -le 65535 ] || die "invalid --port '$host_port'"
if [ "$no_publish" = 1 ]; then publish=(); elif [ "${#publish[@]}" = 0 ]; then publish=("$bind_addr:$host_port:3000"); fi

# Print in dry-run, run otherwise. Read-only queries always run (they decide what happens).
run() {
  printf '+'; printf ' %q' "$@"; printf '\n'
  [ "$dry" = 1 ] || "$@"
}

[ -x "$launcher" ] || die "launcher not executable: $launcher (set REVERIE_LAUNCHER)"
resolve_dir() { [ -d "$2" ] || die "$1 does not exist: $2"; (cd -- "$2" && pwd -P); }
repo="$(resolve_dir repo "$repo")"
scratch="$(resolve_dir scratch "$scratch")"
instance="$(resolve_dir instance "$instance")"
# Never mount an empty or wrong directory over the private instance or the shared scratch.
[ -f "$instance/config/instance.json" ] || die "instance has no config/instance.json: $instance"
[ -d "$scratch/repos" ] || die "scratch has no repos/ (wrong directory?): $scratch"

if [ -z "$console_source" ] || [ "$console_source" = repo ]; then console_source="$source_repo/apps/console"; fi
if [ -z "$reverie_source" ] || [ "$reverie_source" = repo ]; then reverie_source="$source_repo/python/reverie"; fi
console_source="$(resolve_dir console-source "$console_source")"
reverie_source="$(resolve_dir reverie-source "$reverie_source")"
for f in package.json package-lock.json src; do
  [ -e "$console_source/$f" ] || die "console source lacks $f: $console_source"
done
[ -f "$reverie_source/runtime.py" ] || die "reverie source lacks runtime.py: $reverie_source"

memory="$("$launcher" memory-default)" || die "could not size memory"
exists=0
if "$launcher" engine container exists "$name"; then exists=1; fi

echo "Container:      $name (image $image)"
echo "Mounts:         $repo -> /workspace"
echo "                $scratch -> /scratch"
echo "                $instance -> $target"
echo "Model:          ${model:-instance default} at ${api_base:-instance default}"
echo "Memory:         $memory (swap = memory)"
echo "Publish:        ${publish[*]:-none}"
echo "Image console:  $console_source"
echo "Image reverie:      $reverie_source"
[ "$dry" = 0 ] || echo "DRY RUN: nothing below is executed."

if [ "$exists" = 1 ]; then
  [ "$replace" = 1 ] || die "a container named '$name' exists; pass --replace to stop and remove it (mounted data is kept)"
  run "$launcher" engine stop --time 30 "$name"
  run "$launcher" engine rm "$name"
fi

if [ "$build" = 1 ] && [ "$dry" = 1 ]; then
  echo "Build context:  (staged at run time from the repo, console and reverie sources above)"
  run env REVERIE_REPO="<staged context>" REVERIE_IMAGE="$image" "$launcher" build
elif [ "$build" = 1 ]; then
  # Stage the flake and its sources, with the chosen console and reverie trees.
  mkdir -p "$HOME/scratch/reverie/tmp"
  context="$(mktemp -d "$HOME/scratch/reverie/tmp/reverie-build.XXXXXX")"
  trap 'rm -rf -- "$context"' EXIT
  echo "Build context:  $context"
  for f in flake.nix flake.lock nix README.md LICENSE THIRD_PARTY_NOTICES.md docker scripts tests; do
    cp -a -- "$source_repo/$f" "$context/"
  done
  mkdir -p "$context/apps/console" "$context/python/reverie"
  cp -a -- "$source_repo/python/experts" "$context/python/experts"
  cp -a -- "$source_repo/python/pyproject.toml" "$source_repo/python/README.md" "$source_repo/python/LICENSE" "$context/python/"
  (cd -- "$console_source" && tar --exclude=./node_modules --exclude=./.git -cf - .) | (cd -- "$context/apps/console" && tar -xf -)
  (cd -- "$reverie_source" && tar --exclude=__pycache__ -cf - .) | (cd -- "$context/python/reverie" && tar -xf -)
  run env REVERIE_REPO="$context" REVERIE_IMAGE="$image" "$launcher" build
fi

# Create only: reverie.service (reverie-container engine start --attach) starts and owns it.
args=(create --pull=never --init --name "$name" --label reverie.managed=true
  --userns=keep-id:uid=2000,gid=2000 --user 2000:2000
  --cap-drop=all --cap-add=chown,dac_override,fowner,fsetid,kill,setgid,setuid,setpcap,net_bind_service,sys_chroot,setfcap
  --memory="$memory" --memory-swap="$memory" --pids-limit=512
  --network=pasta:--map-host-loopback,169.254.1.2)
for p in "${publish[@]}"; do args+=(--publish "$p"); done
args+=(--env "REVERIE_INSTANCE_CONFIG=$target/config/instance.json"
  --env "REVERIE_DATA_DIR=$target/runtime/console")
if [ -n "$api_base" ]; then args+=(--env "REVERIE_API_BASE=$api_base"); fi
if [ -n "$model" ]; then args+=(--env "REVERIE_MODEL=$model"); fi
args+=(--env REVERIE_CASES_PATH=/scratch/cases --env REVERIE_RESEARCH_ROOT=/scratch/research
  --env REVERIE_API_URL=http://127.0.0.1:3000
  --log-driver=k8s-file --log-opt=max-size=10mb
  --mount "type=bind,src=$repo,dst=/workspace"
  --mount "type=bind,src=$scratch,dst=/scratch"
  --mount "type=bind,src=$instance,dst=$target"
  --entrypoint /usr/bin/env "$image" /usr/local/bin/reverie web --host 0.0.0.0 --port 3000 --allow-unauthenticated-network)
run "$launcher" engine "${args[@]}"

if [ "$install_launcher" = 1 ]; then
  run mkdir -p "$(dirname "$installed_launcher")"
  if [ -f "$installed_launcher" ]; then run cp -p "$installed_launcher" "$installed_launcher.bak"; fi
  run install -m 0755 "$here/reverie-container" "$installed_launcher"
fi

echo "Next: systemctl --user start reverie.service (or: $launcher engine start $name), then run"
echo "      scripts/reverie-restore inside the container (see its --help) before starting agents."
